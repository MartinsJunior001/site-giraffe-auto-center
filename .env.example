# URL pública confirmada, sem barra final
NEXT_PUBLIC_SITE_URL=
# Ativar apenas quando conteúdo, política e integrações estiverem aprovados
NEXT_PUBLIC_INDEXABLE=false
# URL HTTPS do webhook do Make (Custom Webhook) que grava os leads na planilha; somente no servidor
LEAD_WEBHOOK_URL=
# Chave de API do webhook do Make, enviada no cabeçalho x-make-apikey; somente no servidor
LEAD_WEBHOOK_TOKEN=
