# URL pública confirmada, sem barra final
NEXT_PUBLIC_SITE_URL=
# Ativar apenas quando conteúdo, política e integrações estiverem aprovados
NEXT_PUBLIC_INDEXABLE=false
# Endpoint HTTPS que recebe POST JSON de leads; somente no servidor
LEAD_WEBHOOK_URL=
# Token opcional enviado no header Authorization: Bearer; somente no servidor
LEAD_WEBHOOK_TOKEN=
