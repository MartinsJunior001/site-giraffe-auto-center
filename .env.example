# URL pública confirmada, sem barra final
NEXT_PUBLIC_SITE_URL=
# Ativar apenas quando conteúdo, política e integrações estiverem aprovados
NEXT_PUBLIC_INDEXABLE=false
# URL HTTPS do webhook do Make (Custom Webhook) que grava os leads na planilha; somente no servidor
LEAD_WEBHOOK_URL=
# Chave de API do webhook do Make, enviada no cabeçalho x-make-apikey; somente no servidor
LEAD_WEBHOOK_TOKEN=

# Pipefy (funil "[CO] Comercial", pipe 303033937). Só no servidor: nunca use NEXT_PUBLIC_ nestas variáveis.
# Com PIPEFY_CLIENT_ID definido, os leads vão para o Pipefy em vez do webhook do Make.
# Client ID e Client Secret da conta de serviço site-giraffe-leads: configurar só no Coolify (ou em .env.pipefy.local para
# a consulta local de leitura). Nunca versionar.
# IDs dos campos e tradução das opções ficam em src/content/pipefy.ts; PIPEFY_PIPE_ID precisa ser o pipe desse mapeamento.
PIPEFY_PIPE_ID=303033937
PIPEFY_CLIENT_ID=
PIPEFY_CLIENT_SECRET=
PIPEFY_TOKEN_URL=https://app.pipefy.com/oauth/token
PIPEFY_API_URL=https://api.pipefy.com/graphql
